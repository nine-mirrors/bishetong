# 复制为 server/.env 后填写真实值（.env 已被 .gitignore 忽略）
DATABASE_URL="mysql://root:你的密码@localhost:3306/bishe_dev"
JWT_SECRET="请替换为随机字符串"
JWT_EXPIRES_IN="7d"
PORT=3100
CORS_ORIGIN="http://localhost:5173,http://localhost:5181"

# 邮件（可选）：配置后系统通知会同步发送邮件
SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# 可选：演示环境把所有通知邮件重定向到该地址，避免发往不存在的演示邮箱
MAIL_OVERRIDE_TO=""

# 可信时间戳（RFC 3161 TSA，可选；归档时自动申请）
TSA_URL="http://timestamp.digicert.com"

# 对象存储（可选）：阿里云 OSS，未配置时自动使用本地 server/uploads
# 注意：Bucket 必须保持「私有」，系统通过服务端鉴权后转发文件，不使用公共读或直链
OSS_REGION=""
OSS_BUCKET=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
# 可选：自定义 Endpoint（如 oss-cn-hangzhou.aliyuncs.com）
OSS_ENDPOINT=""
OSS_PREFIX="bishe"

# AI（可选）：千问 / DeepSeek，均为 OpenAI 兼容接口
# 留空 AI_PROVIDER 时自动选择已配置 Key 的一方
AI_PROVIDER=""
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# 按控制台实际模型名填写，例如 deepseek-chat / deepseek-flash
DEEPSEEK_MODEL="deepseek-chat"
